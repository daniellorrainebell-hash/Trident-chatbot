{
  "expo": {
    "name": "RABID: The Kennel",
    "slug": "rabid-the-kennel",
    "scheme": "kennel",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rabidgymwear.kennel",
      "infoPlist": {
        "UIUserInterfaceStyle": "Dark",
        "NSCameraUsageDescription": "Take progress photos and attach proof to challenges.",
        "NSPhotoLibraryUsageDescription": "Choose progress photos from your library.",
        "NSPhotoLibraryAddUsageDescription": "Save shareable PR and Contract cards to your library."
      }
    },
    "android": {
      "package": "com.rabidgymwear.kennel",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}