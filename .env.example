# =============================================================================
# Nexus IQ LinkedIn Content Engine
# Copy to .env.local and fill in. Never commit .env.local.
# =============================================================================

# --- OpenAI -------------------------------------------------------------------
# SERVER ONLY. Must never be exposed to the browser.
OPENAI_API_KEY=

# Model routing. Every model ID is environment configurable on purpose:
# API offerings change, and no model ID should be hard-coded in application code.
OPENAI_MODEL_PRIMARY=gpt-5.6-terra
OPENAI_MODEL_DEEP=gpt-5.6-sol
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional. Only needed if using OpenAI hosted File Search for static framework docs.
OPENAI_VECTOR_STORE_ID=

# --- Supabase -----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row level security. Must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database -----------------------------------------------------------------
DATABASE_URL=

# --- App ----------------------------------------------------------------------
APP_ENV=development
