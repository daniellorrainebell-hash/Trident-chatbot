# =============================================================================
# Nexus IQ LinkedIn Content Engine
# Copy to .env.local and fill in. Never commit .env.local.
#
# Only OPENAI_API_KEY is required. Without Supabase the engine stores everything
# in a local JSON file under .data/, which is enough for a single user.
# =============================================================================

# --- Model provider: set ONE of these three -----------------------------------
# Whichever key is present is used. All are SERVER ONLY.
#
#   OpenAI     the provider the engine was built and tested against
#   Anthropic  full support, but no embeddings endpoint, so semantic retrieval
#              needs an OpenAI or Google key alongside it
#   Google     supported; the least exercised of the three adapters
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Only needed if more than one key above is set. openai | anthropic | google
MODEL_PROVIDER=

# The master password that unlocks the app. One password, one user.
#
# Required for any deployment. Without it the app serves localhost only and
# refuses remote traffic, rather than leaving an unauthenticated endpoint that
# spends money on every request.
NEXUS_ACCESS_PASSKEY=


# --- Model routing ------------------------------------------------------------
# Every model ID is configurable on purpose: API offerings change, and no model
# ID is hard-coded in application code. Only the block for your chosen provider
# matters.
#
# primary  strategist, hook engine, outline, writer, critic, distribution
# deep     research and fact checking
# fast     hook scoring and feedback extraction

OPENAI_MODEL_PRIMARY=gpt-5.6-terra
OPENAI_MODEL_DEEP=gpt-5.6-sol
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_MODEL_PRIMARY=claude-opus-5
ANTHROPIC_MODEL_DEEP=claude-opus-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

GOOGLE_MODEL_PRIMARY=gemini-2.5-pro
GOOGLE_MODEL_DEEP=gemini-2.5-pro
GOOGLE_MODEL_FAST=gemini-2.5-flash
GOOGLE_EMBEDDING_MODEL=text-embedding-004

# --- Optional: Supabase -------------------------------------------------------
# Add all three to switch from the local JSON file to Postgres. This is what
# turns on semantic retrieval over your previous posts and knowledge base.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Optional: OpenAI hosted file search --------------------------------------
OPENAI_VECTOR_STORE_ID=

# --- Optional: local storage --------------------------------------------------
# Where the local JSON store lives when Supabase is not configured.
NEXUS_DATA_DIR=.data

# Single-user deployment. There is no login; this identifies the owner's data.
NEXUS_USER_ID=00000000-0000-0000-0000-000000000001

APP_ENV=development
